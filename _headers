/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(self), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://api.aladhan.com https://api.quran.com https://api.alquran.cloud https://geocoding-api.open-meteo.com https://api.open-meteo.com https://api-bdc.io https://api.bigdatacloud.net https://www.ngdc.noaa.gov https://overpass-api.de https://z.overpass-api.de https://maps.mail.ru https://overpass.kumi.systems https://dailydeenhub-push.memoliro.workers.dev https://formsubmit.co https://tiles.openfreemap.org https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Audio filenames are not versioned, so don't mark them immutable.
/audio/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=2592000

/manifest.json
  Content-Type: application/manifest+json
